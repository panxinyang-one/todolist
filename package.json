{
  "name": "todolist",
  "private": true,
  "scripts": {
    "db:up": "docker compose -f deploy/docker-compose.dev.yml --env-file .env up -d",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml --env-file .env down",
    "db:logs": "docker compose -f deploy/docker-compose.dev.yml logs -f mysql"
  }
}
